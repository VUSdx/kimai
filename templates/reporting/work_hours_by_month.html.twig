{% extends 'reporting/report_user_list_layout.html.twig' %}

{% block report_form_layout %}
    {{ form_widget(form.date) }}
    {% if form.users is defined %}
        {{ form_widget(form.users, {'label': false}) }}
    {% endif %}
    {% from '@theme/components/buttons.html.twig' import submit_button %}
    {{ submit_button('download', {'attr': {'formaction': path(export_route)}, 'icon': 'download', 'combined': false}) }}
{% endblock %}

{% block report_content %}
    <table class="table table-hover dataTable">
        <thead>
            <tr>
                <th>{{ 'date'|trans }}</th>
                {% for user in users %}
                    <th class="text-center text-nowrap">
                        <a href="{{ path('report_user_year', {'date': year|report_date, 'user': user.id}) }}">
                            {{ user.displayName|sanitize_dde }}
                        </a>
                    </th>
                {% endfor %}
                <th class="text-center text-nowrap reportDataTypeTitle">{{ 'stats.durationTotal'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            {% set row_class = (row.date is weekend ? ' weekend' : '') ~ (row.date is today ? ' today' : '') %}
            <tr>
                <td class="text-nowrap{{ row_class }}">
                    {{ row.date|date_short }}
                </td>
                {% for user in users %}
                    <td class="text-nowrap text-center day-total{{ row_class }}">
                        {% if row.durations[user.id].duration != 0 %}
                            <a href="{{ path('report_user_month', {'date': create_date(row.date.format('Y') ~ '-' ~ row.date.format('m') ~ '-01')|report_date, 'user': user.id}) }}" data-toggle="tooltip" title="{{ 'billable'|trans }}: {{ row.durations[user.id].billable|duration(decimal) }}">
                                {{ row.durations[user.id].duration|duration(decimal) }}
                            </a>
                        {% endif %}
                    </td>
                {% endfor %}
                <td class="text-nowrap text-center total{{ row_class }}">
                    {% if row.total != 0 %}
                        {{ row.total|duration(decimal) }}
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
            <tr class="summary">
                <td>{{ 'stats.durationTotal'|trans }}</td>
                {% for user in users %}
                    <td class="text-center text-nowrap">
                        {{ userTotals[user.id]|duration(decimal) }}
                    </td>
                {% endfor %}
                <td class="text-center text-nowrap">
                    {{ total|duration(decimal) }}
                </td>
            </tr>
        </tfoot>
    </table>
{% endblock %}
