{% extends 'reporting/report_user_list_layout.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block report_form_layout %}
    {{ form_widget(form.date) }}
    {% if form.user is defined %}
        {{ form_widget(form.user, {'label': false}) }}
    {% endif %}
    {% from '@theme/components/buttons.html.twig' import submit_button %}
    {{ submit_button('download', {'attr': {'formaction': path(export_route)}, 'icon': 'download', 'combined': false}) }}
{% endblock %}

{% block report_content %}
    <table class="table table-hover dataTable">
        <thead>
            <tr>
                <th>{{ 'date'|trans }}</th>
                <th>&nbsp;</th>
                <th class="text-center reportDataTypeTitle">{{ 'stats.durationTotal'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for day in days %}
            {% set day_class = (day.date is weekend ? ' weekend' : '') ~ (day.date is today ? ' today' : '') %}
            <tr>
                <td class="text-nowrap{{ day_class }}">
                    <a href="{{ path('report_user_month', {'date': create_date(day.date.format('Y') ~ '-' ~ day.date.format('m') ~ '-01')|report_date, 'user': user.id}) }}">
                        {{ day.date|date_short }}
                    </a>
                </td>
                <td class="text-nowrap{{ day_class }}">
                    {{ day.date|day_name(true) }}
                </td>
                <td class="text-nowrap text-center day-total{{ day_class }}">
                    {% if day.totalDuration != 0 %}
                        <span data-toggle="tooltip" title="{{ 'billable'|trans }}: {{ day.billableDuration|duration(decimal) }}">
                            {{ day.totalDuration|duration(decimal) }}
                        </span>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
            <tr class="summary">
                <td colspan="2">{{ 'stats.durationTotal'|trans }}</td>
                <td class="text-center text-nowrap">
                    <a href="{{ path('report_user_year', {'date': year|report_date, 'user': user.id}) }}">
                        {{ total|duration(decimal) }}
                    </a>
                </td>
            </tr>
        </tfoot>
    </table>
{% endblock %}
