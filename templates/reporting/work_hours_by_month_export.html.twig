<table>
    <thead>
        <tr>
            <th>{{ 'date'|trans }}</th>
            {% for user in users %}
                <th>{{ user.displayName|sanitize_dde }}</th>
            {% endfor %}
            <th>{{ 'stats.durationTotal'|trans }}</th>
        </tr>
        <tr>
            <th>{{ 'account_number'|trans }}</th>
            {% for user in users %}
                <th>{{ user.accountNumber }}</th>
            {% endfor %}
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody>
    {% for row in rows %}
        <tr>
            <td>{{ row.date|date_short }}</td>
            {% for user in users %}
                <td>{{ row.durations[user.id].duration|duration(true) }}</td>
            {% endfor %}
            <td>{{ row.total|duration(true) }}</td>
        </tr>
    {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td>{{ 'stats.durationTotal'|trans }}</td>
            {% for user in users %}
                <td>{{ userTotals[user.id]|duration(true) }}</td>
            {% endfor %}
            <td>{{ total|duration(true) }}</td>
        </tr>
    </tfoot>
</table>
