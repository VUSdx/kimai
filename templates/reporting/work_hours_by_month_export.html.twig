{% embed 'reporting/user_list_period_data.html.twig' with {'avatar': false, 'showAccountNumber': true, 'stats': stats, 'dataType': 'duration', 'period_attribute': period_attribute} only %}
    {% block duration -%}
        {{ period.totalDuration|duration(true) }}
    {%- endblock %}
    {% block total_duration -%}
        {{ absoluteDuration|duration(true) }}
    {%- endblock %}
    {% block total_duration_user -%}
        {{ usersTotalDuration|duration(true) }}
    {%- endblock %}
    {% block total_duration_period -%}
        {{ total|duration(true) }}
    {%- endblock %}
    {% block period_name %}
        <th class="text-center text-nowrap">
            {{ column|date_short }}
        </th>
    {% endblock %}
{% endembed %}
