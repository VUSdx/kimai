{% extends 'reporting/layout.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block report_form_layout %}
    {{ form_widget(form.date) }}
    {% if form.user is defined %}
        {{ form_widget(form.user, {'label': false}) }}
    {% elseif app.user != user %}
        {{ widgets.username(user) }}
    {% endif %}
{% endblock %}

{% block report %}
    {% embed '@theme/embeds/card.html.twig' with {box_id: box_id, fullsize: false} %}
        {% block box_body %}
            <div class="datagrid p-3">
                <div class="datagrid-item">
                    <div class="datagrid-title">{{ 'vacation_hours_available'|trans }}</div>
                    <div class="datagrid-content fw-bold">{{ allowanceHours|number_format(1) }}</div>
                </div>
                <div class="datagrid-item">
                    <div class="datagrid-title">{{ 'vacation_hours_used'|trans }}</div>
                    <div class="datagrid-content fw-bold {% if usedHours > allowanceHours %}text-danger{% endif %}">{{ usedHours|number_format(1) }}</div>
                </div>
                <div class="datagrid-item">
                    <div class="datagrid-title">{{ 'vacation_hours_remaining'|trans }}</div>
                    <div class="datagrid-content fw-bold {% if remainingHours < 0 %}text-danger{% else %}text-success{% endif %}">{{ remainingHours|number_format(1) }}</div>
                </div>
            </div>
        {% endblock %}
    {% endembed %}

    {% embed '@theme/embeds/card.html.twig' with {box_id: box_id ~ '-monthly', fullsize: true} %}
        {% block box_body_class %}{{ box_id }}-monthly table-responsive m-0{% endblock %}
        {% block box_body %}
            <table class="table table-hover dataTable">
                <thead>
                    <tr>
                        <th>{{ user.displayName|default(user.userIdentifier)|default('')|sanitize_dde }}</th>
                        {% for month in 1..12 %}
                            <th class="text-center text-nowrap">
                                <a href="{{ path('report_user_month', {'date': monthlyData[month]['month']|date('Y-m-d'), 'user': user.id}) }}">
                                    {{ monthlyData[month]['month']|date('M') }}
                                </a>
                            </th>
                        {% endfor %}
                        <th class="text-center text-nowrap">{{ 'stats.durationTotal'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ widgets.username(user) }}</td>
                        {% for month in 1..12 %}
                            <td class="text-center">
                                {{ monthlyData[month]['hours']|number_format(1) }}
                            </td>
                        {% endfor %}
                        <td class="text-center fw-bold">{{ usedHours|number_format(1) }}</td>
                    </tr>
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
